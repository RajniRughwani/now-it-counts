# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# Anthropic API key — used server-side for GP summary phrasing (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — run scripts/create-elevenlabs-agent.mjs to create the agent and get an ID
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Same value as above — exposed to the browser to start voice sessions (agent is public)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
